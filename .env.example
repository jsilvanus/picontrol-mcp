# Copy to ~/apps/picontrol-mcp.env (mode 0600) and edit. Replace every placeholder.
HOST=0.0.0.0
PORT=3200
# The address clients use. Plain http works for personal access tokens on the LAN; OAuth clients that insist on https
# need a TLS front (see README).
MCP_PUBLIC_URL=http://kirkonpi.local:3200
# Extra Host header values allowed on /mcp (host:port), comma separated. MCP_PUBLIC_URL's host is allowed already.
MCP_ALLOWED_HOSTS=192.168.1.60:3200
# oauth | token | both
AUTH_MODE=both
# base64, at least 32 bytes: npm run user -- secret
JWT_SECRET=
# Services. Set a URL to "off" to switch its tool group off.
PIMATRIX_URL=http://127.0.0.1:3000
PIMATRIX_API_KEY=replace-with-the-pimatrix-api-key
PIVOICE_URL=http://127.0.0.1:8095
PIVOICE_API_TOKEN=replace-with-the-pivoice-api-token
# Optional paths. Defaults: ~/.config/picontrol-mcp/users.json, ~/.local/state/picontrol-mcp/{state.sqlite,audit.log}
# USERS_PATH=
# STATE_PATH=
# AUDIT_PATH=
