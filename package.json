{
  "name": "picontrol-mcp",
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "private": true,
  "type": "module",
  "description": "MCP server for the Pi stack: routing, cameras, ATEM, program, composites and voice, over Streamable HTTP.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "picontrol-mcp-user": "dist/cli/user.js"
  },
  "scripts": {
    "spec:sync": "node scripts/sync-specs.mjs",
    "generate": "node scripts/generate-clients.mjs",
    "prebuild": "pnpm run generate",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "user": "node dist/cli/user.js",
    "pretest": "pnpm run generate",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.2.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "openapi-typescript-codegen": "^0.29.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "pi": {
    "service": "picontrol-mcp",
    "layer": "Control plane",
    "displayName": "picontrol MCP server",
    "port": 3600,
    "healthEndpoint": "/health",
    "envPortVar": "PORT"
  }
}
